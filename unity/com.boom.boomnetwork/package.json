{
  "name": "com.boom.boomnetwork",
  "version": "0.1.0",
  "displayName": "BoomNetwork",
  "description": "帧同步网络库 — TCP/KCP 双端通信、心跳保活、断线重连、策略模式",
  "unity": "2022.3",
  "author": {
    "name": "Boom",
    "url": "https://github.com/boomlulu/BoomNetwork"
  },
  "keywords": [
    "network",
    "framesync",
    "lockstep",
    "multiplayer",
    "tcp",
    "kcp"
  ],
  "samples": [
    {
      "displayName": "Hello World",
      "description": "Level 0 — 最小接入，QuickStart 一键跑通",
      "path": "Samples~/HelloWorld"
    },
    {
      "displayName": "Room Lobby",
      "description": "Level 1 — 房间大厅，手动控制连接/建房/加入/开始",
      "path": "Samples~/RoomLobby"
    },
    {
      "displayName": "Reconnect",
      "description": "Level 2 — 断线重连，快照序列化/模拟断线/自动恢复",
      "path": "Samples~/Reconnect"
    },
    {
      "displayName": "Entity Sync",
      "description": "Level 3 — 实体权威同步，IEntitySync/自权威零延迟/远端平滑",
      "path": "Samples~/EntitySync"
    },
    {
      "displayName": "Authority Transfer",
      "description": "Level 6 — 运行时权威转移（抢球演示）",
      "path": "Samples~/AuthorityTransfer"
    },
    {
      "displayName": "Chat Room",
      "description": "聊天房 — SendStateMessage 实时消息广播，无需帧同步",
      "path": "Samples~/ChatRoom"
    },
    {
      "displayName": "State Sync Move",
      "description": "状态同步移动 — 纯 SendStateMessage 广播位置，无需帧同步",
      "path": "Samples~/StateSyncMove"
    },
    {
      "displayName": "Minecraft Demo",
      "description": "多人方块世界 — 混合同步（Entity Sync + Frame Sync + Snapshot）",
      "path": "Samples~/MinecraftDemo"
    },
    {
      "displayName": "Tower Defense",
      "description": "多人塔防 — 纯帧同步，7 种塔 + 5 种敌人 + 双层经济系统，展示 512 敌人零额外带宽",
      "path": "Samples~/TowerDefense"
    },
    {
      "displayName": "Vampire Survivors",
      "description": "弹幕生存 — 纯帧同步，512 怪零额外带宽，FInt 定点数，空间哈希碰撞",
      "path": "Samples~/VampireSurvivors"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/boomlulu/BoomNetwork.git"
  }
