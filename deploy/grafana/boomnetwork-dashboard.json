{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "title": "Connections & Rooms",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }] } } },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "boom_connections_current", "legendFormat": "connections" }],
      "title": "Active Connections",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "blue", "value": null }] } } },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "boom_rooms_current", "legendFormat": "rooms" }],
      "title": "Active Rooms",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 1 },
      "targets": [
        { "expr": "rate(boom_connections_total[1m])", "legendFormat": "new/sec" }
      ],
      "title": "New Connections Rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "title": "Frame Sync Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 6 },
      "targets": [
        { "expr": "rate(boom_frames_pushed_total[1m])", "legendFormat": "frames/sec" }
      ],
      "title": "Frames Pushed Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 6 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(boom_frame_broadcast_latency_seconds_bucket[1m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(boom_frame_broadcast_latency_seconds_bucket[1m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(boom_frame_broadcast_latency_seconds_bucket[1m]))", "legendFormat": "p99" }
      ],
      "title": "Frame Broadcast Latency",
      "type": "timeseries",
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 6 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(boom_room_lifetime_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(boom_room_lifetime_seconds_bucket[5m]))", "legendFormat": "p95" }
      ],
      "title": "Room Lifetime",
      "type": "timeseries",
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "title": "Reliability",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 13 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "rate(boom_reconnect_success_total[5m])", "legendFormat": "success/sec" }],
      "title": "Reconnect Success",
      "type": "stat",
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }] } } }
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 13 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "rate(boom_reconnect_fail_total[5m])", "legendFormat": "fail/sec" }],
      "title": "Reconnect Fail",
      "type": "stat",
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "red", "value": null }] } } }
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 13 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "boom_snapshot_size_bytes", "legendFormat": "bytes" }],
      "title": "Snapshot Size",
      "type": "stat",
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 65536 }, { "color": "red", "value": 262144 }] } } }
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 13 },
      "targets": [{ "expr": "rate(boom_room_panics_total[5m])", "legendFormat": "panics/sec" }],
      "title": "Room Panics",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "title": "Traffic & Errors",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 },
      "targets": [
        { "expr": "rate(boom_bytes_sent_total[1m])", "legendFormat": "TX bytes/sec" },
        { "expr": "rate(boom_bytes_received_total[1m])", "legendFormat": "RX bytes/sec" }
      ],
      "title": "Network Traffic",
      "type": "timeseries",
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 18 },
      "targets": [
        { "expr": "rate(boom_message_errors_total[1m])", "legendFormat": "msg errors/sec" },
        { "expr": "rate(boom_rate_limited_total[1m])", "legendFormat": "rate limited/sec" },
        { "expr": "rate(boom_auth_failures_total[1m])", "legendFormat": "auth failures/sec" }
      ],
      "title": "Errors & Rate Limiting",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["boomnetwork", "game-server"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "default", "value": "default" },
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "BoomNetwork Server",
  "uid": "boomnetwork-server",
  "version": 1
}
